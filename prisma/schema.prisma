generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// USER / AUTHENTICATION
// ==============================

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole @default(OFFICER)
  createdAt DateTime @default(now())

  notifications Notification[]
}

enum UserRole {
  ADMIN
  MANAGER
  OFFICER
  VIEWER
}

// ==============================
// NOTIFICATIONS
// ==============================

model Notification {
  id        Int              @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ==============================
// SECURITY INCIDENTS
// ==============================

model Incident {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  severity    Severity
  status      Status   @default(OPEN)
  createdAt   DateTime @default(now())

  personnelId Int?
  personnel   Personnel? @relation(fields: [personnelId], references: [id])
}

// ==============================
// SECURITY PERSONNEL
// ==============================

model Personnel {
  id        Int             @id @default(autoincrement())
  fullName  String
  role      String
  phone     String
  site      String
  status    PersonnelStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  incidents Incident[]
}

// ==============================
// SECURITY SITES
// ==============================

model Site {
  id        Int        @id @default(autoincrement())
  name      String
  location  String
  client    String
  contact   String?
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
}

// ==============================
// NOTIFICATION TYPE
// ==============================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

// ==============================
// INCIDENT SEVERITY
// ==============================

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==============================
// INCIDENT STATUS
// ==============================

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ==============================
// SITE STATUS
// ==============================

enum SiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

// ==============================
// PERSONNEL STATUS
// ==============================

enum PersonnelStatus {
  ACTIVE
  OFF_DUTY
  SUSPENDED
}
